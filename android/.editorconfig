root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
# Max line length matches detekt config
max_line_length = 140
# Compose: @Composable functions are PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.kts]
max_line_length = 140

# Disable all ktlint rules for generated sources in build/ (the UniFFI bindings).
# These files cannot be edited and have a different style from the project convention.
[**/build/**/*.kt]
ktlint_standard = disabled
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.{json,xml}]
indent_size = 4
