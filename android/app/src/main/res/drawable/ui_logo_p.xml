<?xml version="1.0" encoding="utf-8"?>
<!--
    The p of the Pili wordmark alone (the bar and the ring of ui_logo.xml), for the narrow app header. Viewport
    0,0 100x140 is the p's own box in the wordmark coordinates. White, tinted by the caller; the bolt that strikes
    it is ui_logo_p_bolt.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="140dp"
    android:viewportWidth="100"
    android:viewportHeight="140">
    <!-- p: the bar (rect 0,0 22x140) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0H22V140H0Z" />
    <!-- p: the ring (circle 50,50 r39, stroke 22) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M11,50A39,39 0 1,0 89,50A39,39 0 1,0 11,50Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="22" />
</vector>
