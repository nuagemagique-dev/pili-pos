<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug only: ends the session from adb (adb shell am broadcast); DUMP is held by the shell user. -->
        <receiver
            android:name="dev.nuagemagique.pilipos.debugtools.DebugTeardownReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.nuagemagique.pilipos.debug.TEARDOWN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
