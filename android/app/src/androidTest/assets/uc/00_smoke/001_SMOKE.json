{
  "format": 1,
  "id": "SMOKE",
  "ids": [],
  "title": "Login, one takeaway sale of two Perrier paid in cash, then an X report",
  "steps": [
    { "cmd": "login", "args": { "insz": "94060242576", "pin": "1111" } },
    {
      "cmd": "create_order",
      "args": { "input": { "order_type": "takeaway", "table_number": null, "user_insz": "94060242576" } },
      "save": "order"
    },
    {
      "cmd": "add_order_line",
      "args": { "input": { "order_id": "$order.id", "menu_item_id": 12007, "quantity": 2, "modifiers_json": null } }
    },
    {
      "cmd": "checkout",
      "args": { "orderId": "$order.id", "payments": [{ "method": "cash" }] },
      "save": "sale",
      "expect": { "fields": { "success": true } }
    },
    { "cmd": "generate_x_report", "args": { "employeeInsz": "94060242576" } }
  ]
}
