{
  "productName": "pili-pos",
  "version": "1.0.0",
  "identifier": "dev.nuagemagique.pili-pos",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui"
  },
  "app": {
