#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────
# pili-installer - USB installer/updater, run by pili-installer.service
# only when the kernel command line carries pili.installer=install or
# pili.installer=update (i.e. only when booted FROM the USB stick with
# that menu entry picked - a normal boot never reaches this script; see
# the unit's ConditionKernelCommandLine=).
#
# install: wipes the internal disk and replicates this USB stick's
#          partition table (ESP + root) and content onto it. The rest
#          of the disk is left free for systemd-repart to claim as the
#          "pili-data" partition on the first real boot.
# update:  copies ONLY the CONTENTS of partitions 1 (ESP) and 2 (root)
#          into the internal disk's EXISTING partitions 1 and 2,
#          without touching its partition table at all - so its
#          existing "pili-data" partition (partition 3, the fiscal
#          database) is never disturbed. This is why update copies
#          partition-to-partition rather than disk-to-disk.
#          The root and spf password hashes set at first boot live in
#          the old root's /etc/shadow: they are carried over into the
#          new root, else both accounts would be locked again.
#
# Unattended install (deploy/usb/make-key.sh makes "Install" the USB
# key's default boot entry): on a disk WITHOUT a "pili-data" partition
# (a new terminal, whatever it shipped with) the install starts after a
# short countdown that any key cancels. A disk that already holds
# "pili-data" (fiscal data) always needs OUI typed, as does update.
#
# After the copy, the internal ESP is cleaned of the USB-only bits
# (Install/Update UKIs, the key's loader.conf), and a "pili-pos" UEFI
# boot entry for the internal disk is put first in BootOrder: the next
# boot, and every later one, starts from the internal disk even if the
# key is left plugged in.
#
# Both modes finish with `sgdisk -e` ("fix backup GPT"): a disk-image
# dd only ever writes a correct PRIMARY GPT (at the start); the
# SECONDARY/backup GPT belongs at the true end of the target disk,
# which differs from the source USB stick's size, so it must be
# recomputed in place.
# ─────────────────────────────────────────────────────────────────
set -euo pipefail

log() { echo "[pili-installer] $*"; }

CMDLINE=" $(cat /proc/cmdline) "
MODE=""
if [[ "$CMDLINE" == *" pili.installer=install "* ]]; then
    MODE=install
elif [[ "$CMDLINE" == *" pili.installer=update "* ]]; then
    MODE=update
else
    log "no pili.installer= argument on the kernel command line - nothing to do"
    exit 0
fi

part() { # part <disk> <n> -> /dev/sda1 or /dev/nvme0n1p1
    local disk="$1" n="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        echo "${disk}p${n}"
    else
        echo "${disk}${n}"
    fi
}

SRC_NAME="$(lsblk -dno PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)"
if [[ -z "$SRC_NAME" ]]; then
    log "ERROR: could not determine the USB source disk (booted how?)"
    exit 1
fi
SRC_DISK="/dev/$SRC_NAME"

mapfile -t CANDIDATES < <(lsblk -dno NAME,RM,TYPE \
    | awk -v src="$SRC_NAME" '$3 == "disk" && $2 == "0" && $1 != src {print $1}')
if [[ "${#CANDIDATES[@]}" -eq 0 ]]; then
    log "ERROR: no internal non-removable disk found"
    exit 1
elif [[ "${#CANDIDATES[@]}" -gt 1 ]]; then
    log "ERROR: several candidate internal disks found (${CANDIDATES[*]}) - refusing to guess"
    exit 1
fi
TARGET_DISK="/dev/${CANDIDATES[0]}"

MODE_UPPER="$(echo "$MODE" | tr '[:lower:]' '[:upper:]')"
if [[ "$MODE" == "install" ]]; then
    WARN_LINE="Le disque ${TARGET_DISK} sera ENTIÈREMENT EFFACÉ."
else
    WARN_LINE="Le système sera remplacé ; les données (/var, base fiscale) sont CONSERVÉES."
fi

clear || true
cat <<BANNER
════════════════════════════════════════════════════════════════
  pili-pos - ${MODE_UPPER} sur ${TARGET_DISK}
  Source : ${SRC_DISK} (cette clé USB)

  ${WARN_LINE}
════════════════════════════════════════════════════════════════
BANNER
HAS_PILI_DATA=0
if lsblk -lno PARTLABEL "$TARGET_DISK" 2>/dev/null | grep -qx pili-data; then
    HAS_PILI_DATA=1
fi

if [[ "$MODE" == "install" && "$HAS_PILI_DATA" -eq 0 ]]; then
    # New terminal: nothing fiscal to lose, go on by itself.
    COUNTDOWN=15
    echo "Installation automatique dans ${COUNTDOWN} s - appuyez sur une touche pour ANNULER."
    if read -r -s -n 1 -t "$COUNTDOWN" _; then
        log "Annulé (touche pressée)."
        exit 1
    fi
else
    if [[ "$MODE" == "install" ]]; then
        echo "ATTENTION : ce disque contient déjà une partition pili-data (base fiscale)."
        echo "Pour garder les données, redémarrez et choisissez « Update »."
    fi
    read -r -p "Tapez OUI en majuscules pour confirmer : " CONFIRM
    if [[ "$CONFIRM" != "OUI" ]]; then
        log "Annulé (confirmation refusée)."
        exit 1
    fi
fi

if [[ "$MODE" == "install" ]]; then
    log "Partitioning ${TARGET_DISK} (replicating ${SRC_DISK}'s table)…"
    sgdisk --zap-all "$TARGET_DISK"
    sgdisk --replicate="$TARGET_DISK" "$SRC_DISK"
    sgdisk -G "$TARGET_DISK"
    partprobe "$TARGET_DISK" || true
    udevadm settle --timeout=30 || true
fi

# The password hashes of `user` in the shadow file `file`, if set.
shadow_hash() {
    awk -F: -v u="$1" '$1 == u && $2 != "" && $2 !~ /^[!*]/ {print $2}' "$2"
}

WORK="/run/pili-installer"
declare -A KEPT=()
if [[ "$MODE" == "update" ]]; then
    mkdir -p "$WORK/old"
    if mount -o ro "$(part "$TARGET_DISK" 2)" "$WORK/old"; then
        for user in root spf; do
            hash="$(shadow_hash "$user" "$WORK/old/etc/shadow" || true)"
            [[ -n "$hash" ]] && KEPT[$user]="$hash"
        done
        umount "$WORK/old"
    fi
    log "Password hashes kept: ${!KEPT[*]:-none}"
fi

for n in 1 2; do
    SRC_PART="$(part "$SRC_DISK" "$n")"
    DST_PART="$(part "$TARGET_DISK" "$n")"
    log "Copying partition $n: $SRC_PART -> $DST_PART…"
    dd if="$SRC_PART" of="$DST_PART" bs=4M conv=fsync status=progress
done

if [[ "$MODE" == "update" ]]; then
    if [[ "${#KEPT[@]}" -gt 0 ]]; then
        mkdir -p "$WORK/new"
        mount "$(part "$TARGET_DISK" 2)" "$WORK/new"
        for user in "${!KEPT[@]}"; do
            awk -F: -v OFS=: -v u="$user" -v h="${KEPT[$user]}" \
                '$1 == u {$2 = h} {print}' "$WORK/new/etc/shadow" > "$WORK/shadow.new"
            cat "$WORK/shadow.new" > "$WORK/new/etc/shadow"
        done
        rm -f "$WORK/shadow.new"
        sync
        umount "$WORK/new"
    else
        log "WARNING: no password found on the old system; root stays locked."
    fi
fi

log "Fixing the backup GPT on ${TARGET_DISK}…"
sgdisk -e "$TARGET_DISK"
partprobe "$TARGET_DISK" || true
udevadm settle --timeout=30 || true

# ── The internal ESP is a copy of the key's: drop what only makes
#    sense on the key. Left in place, "Install" would stay the default
#    entry of the internal disk and the terminal would never reach its
#    kiosk. The site directory (pili/site/) stays: pili-bootstrap reads
#    it on the first boot, then deletes its secrets. ─────────────────
ESP_DST="$(part "$TARGET_DISK" 1)"
ESP_MNT="$(mktemp -d)"
mount -t vfat "$ESP_DST" "$ESP_MNT"
rm -f "$ESP_MNT"/EFI/Linux/pili-pos-install.efi "$ESP_MNT"/EFI/Linux/pili-pos-update.efi
if [[ "$MODE" == "update" ]]; then
    # An installed terminal never re-runs its bootstrap on its own: a
    # site directory copied from the key would only leave its secrets
    # on the unencrypted ESP. Re-applying a site is a deliberate
    # `pili-bootstrap --rerun --site <dir>` from the console.
    rm -rf "$ESP_MNT/pili"
fi
# deploy/usb/make-key.sh kept the image's own loader.conf (editor
# setting and the like) as loader.conf.pili-orig: put it back. Without
# it, drop just the key's default/timeout lines.
if [[ -f "$ESP_MNT/loader/loader.conf.pili-orig" ]]; then
    mv -f "$ESP_MNT/loader/loader.conf.pili-orig" "$ESP_MNT/loader/loader.conf"
elif [[ -f "$ESP_MNT/loader/loader.conf" ]]; then
    sed -i -E '/^[[:space:]]*(default|timeout)[[:space:]]/d' "$ESP_MNT/loader/loader.conf"
fi
sync
umount "$ESP_MNT"
rmdir "$ESP_MNT"
log "Internal ESP: installer entries removed, kiosk entry is the default"

# ── Boot from the internal disk from now on (key may stay plugged) ──
BOOT_ENTRY_OK=0
if [[ -d /sys/firmware/efi/efivars ]] && command -v efibootmgr >/dev/null 2>&1; then
    while read -r num; do
        efibootmgr -q -b "$num" -B || true
    # Earlier "pili-pos" entries (a reinstall): "Boot0003* pili-pos<TAB>HD(...)".
    done < <(efibootmgr | awk 'match($0, /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]\*? pili-pos([[:space:]]|$)/) {print substr($0, 5, 4)}')
    if efibootmgr -q --create --disk "$TARGET_DISK" --part 1 \
        --label "pili-pos" --loader '\EFI\systemd\systemd-bootx64.efi'; then
        BOOT_ENTRY_OK=1
        log "UEFI boot entry 'pili-pos' created on ${TARGET_DISK}, first in BootOrder"
    fi
fi

log "${MODE} complete."
if [[ "$BOOT_ENTRY_OK" -eq 1 ]]; then
    echo "Redémarrage sur le disque interne dans 10 s (la clé peut rester branchée)…"
    sleep 10
else
    read -r -p "Retirez la clé USB puis appuyez sur Entrée pour redémarrer… " _ || true
fi
systemctl reboot
