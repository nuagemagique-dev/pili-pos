[Unit]
Description=pili-pos USB installer/updater
DefaultDependencies=no
# OR'd together (the leading "|" is systemd's condition-OR syntax): this
# unit only ever does anything when the USB stick's boot menu entry
# ("Install pili-pos kiosk" / "Update pili-pos kiosk", deploy/image/
# build.sh) put pili.installer=install|update on the kernel command
# line. On a normal kiosk boot both conditions fail and systemd skips
# the unit entirely - this is always "enabled" (see
# deploy/provision/provision.sh --phase image), gated purely by these.
ConditionKernelCommandLine=|pili.installer=install
ConditionKernelCommandLine=|pili.installer=update
After=systemd-udevd.service getty@tty1.service
Before=multi-user.target
# Only getty: this unit is in every boot's transaction (its conditions
# are checked when it runs, not when the transaction is built), so a
# Conflicts= on pili-pos or pili-provision would cancel their start
# on a normal boot. Those two skip installer boots by their own
# ConditionKernelCommandLine=!pili.installer instead.
Conflicts=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/local/lib/pili-pos/pili-installer

[Install]
WantedBy=multi-user.target
