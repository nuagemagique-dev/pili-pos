{
  "compilerOptions": {
    "composite": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "e2e/**/*.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ]
}
