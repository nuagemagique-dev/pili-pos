{
  "name": "pili-pos-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 1420",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "check": "vp check && node scripts/check-vite-plus-pin.mjs",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "prepare": "vp config",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:real-binary": "node --test 'e2e/real-binary/*.test.mjs'",
    "captures": "PW_CAPTURES=1 playwright test --project=captures"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
